    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "6.3.5",
